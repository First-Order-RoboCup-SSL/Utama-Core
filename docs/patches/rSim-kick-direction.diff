 KickStatus SSLRobot::Kicker::getKickerStatus()
 {
     return this->kickerState;
@@ -174,7 +242,7 @@ void SSLRobot::Kicker::kick(dReal kickSpeedX, dReal kickSpeedZ)
 
     unholdBall();
 
-    if (isTouchingBall())
+    if (isNearKickerFace())
     {
         dReal dlen = dx*dx + dy*dy + dz*dz;
         dlen = sqrt(dlen);
@@ -185,7 +253,18 @@ void SSLRobot::Kicker::kick(dReal kickSpeedX, dReal kickSpeedZ)
 
         const dReal* vball = dBodyGetLinearVel(rob->getBall()->body);
         dReal vn = -(vball[0]*dx + vball[1]*dy) * SSLConfig::Robot().getKickerDampFactor();
-        dReal vt = -(vball[0]*dy - vball[1]*dx);
+        // The tangential component was previously left fully undamped (added
+        // back at 100% of the ball's pre-kick sideways speed, vs. the normal
+        // component's kickerDampFactor=0.2 damping). A ball carrying real
+        // lateral velocity at the moment of the kick -- e.g. one that
+        // arrived from a pass and hasn't fully settled, or was still
+        // swinging from a turn_on_spot pivot -- bled that velocity directly
+        // into the kick's resultant direction, confirmed to produce
+        // launch-angle deflections of tens of degrees (matching an observed
+        // real-match ~31 degree mismatch between commanded orientation and
+        // actual ball flight path). Damp it the same way as the normal
+        // component for consistency.
+        dReal vt = -(vball[0]*dy - vball[1]*dx) * SSLConfig::Robot().getKickerDampFactor();
         vx += vn * dx - vt * dy;
         vy += vn * dy + vt * dx;
         dBodySetLinearVel(this->rob->getBall()->body,vx,vy,vz);
